<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SshDashboard.App.Views.HelpWindow"
        Title="SSH Dashboard Help"
        Width="820" Height="780" MinWidth="620" MinHeight="520"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
            Padding="28,20">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentBrush}">
          <Path Data="M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z"
                Fill="White" Width="24" Height="24" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="SSH Dashboard Help" FontSize="19" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Text="A short guide to the views, sessions and safety model."
                     FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
        <Button Grid.Column="2" Content="Close" Click="Close_Click" Classes="ghost"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="36,26,36,34" Spacing="26" MaxWidth="720" HorizontalAlignment="Center">

        <StackPanel Spacing="10">
          <TextBlock Text="Getting started" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}">
            <Run Text="SSH Dashboard reads " />
            <Run Text="~/.ssh/known_hosts" FontFamily="SF Mono, Menlo, monospace"
                 Foreground="{DynamicResource AccentBrush}" />
            <Run Text=", " />
            <Run Text="~/.ssh/config" FontFamily="SF Mono, Menlo, monospace"
                 Foreground="{DynamicResource AccentBrush}" />
            <Run Text=" and the key files beside them. Nothing outside that folder is modified, and every write is preceded by a timestamped backup." />
          </TextBlock>

          <Grid ColumnDefinitions="34,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,4,0,0">
            <Border Grid.Row="0" Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <TextBlock Text="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="Pick a view in the sidebar. Hosts merges known_hosts entries with ssh_config aliases." />
            <Border Grid.Row="1" Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <TextBlock Text="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="Tick rows with the checkbox column, then press Delete or use the footer button. A confirmation lists what will be removed." />
            <Border Grid.Row="2" Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <TextBlock Text="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="Select a host to see its details on the right, test the port, or open an SSH session." />
            <Border Grid.Row="3" Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <TextBlock Text="4" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="To add a new entry, open Configuration and choose Add block, or press Cmd/Ctrl+N." />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="The four views" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <Grid ColumnDefinitions="150,*" Margin="16,12">
                <TextBlock Text="VIEW" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaint}" />
                <TextBlock Grid.Column="1" Text="WHAT IT SHOWS" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaint}" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderSoft}" />
              <Grid ColumnDefinitions="150,*" Margin="16,12">
                <TextBlock Text="Hosts" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Known hosts and config aliases in one list: address, user, port, key types and source. Tick to select; double-click to connect." />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="16,0" />
              <Grid ColumnDefinitions="150,*" Margin="16,12">
                <TextBlock Text="Configuration" FontSize="13" FontWeight="SemiBold" Foreground="#BB9AF7" />
                <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Every Host block. Add a new block, or double-click one to edit patterns, HostName, User, Port and IdentityFile; comments and unknown options are preserved." />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="16,0" />
              <Grid ColumnDefinitions="150,*" Margin="16,12">
                <TextBlock Text="Keys" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SuccessBrush}" />
                <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Private and public keys with SHA-256 fingerprint and permissions, including PuTTY .ppk files. Keys are never modified." />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="16,0" />
              <Grid ColumnDefinitions="150,*" Margin="16,12">
                <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" Foreground="#E0AF68" />
                <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"
                           Text="A local journal of every removal, config edit, import and restore, newest first." />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="Adding a Host block" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}"
                     Text="Open the Configuration view and choose Add block in the footer. The same command is under Tools → Add Host Block and on Cmd/Ctrl+N." />
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="Patterns are space-separated aliases, for example " />
            <Run Text="nas  nas.example.com" FontFamily="SF Mono, Menlo, monospace" Foreground="{DynamicResource AccentBrush}" />
            <Run Text=". HostName, User, Port and IdentityFile are optional." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="The block is appended to the main ~/.ssh/config with a timestamped backup first. Existing blocks, comments and Include files are untouched." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="A global " />
            <Run Text="Host *" FontFamily="SF Mono, Menlo, monospace" Foreground="{DynamicResource AccentBrush}" />
            <Run Text=" block is refused; use a specific alias or pattern." />
          </TextBlock>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="SSH sessions" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}"
                     Text="Open a session with the button in the details rail, Tools → Open SSH Session, or by double-clicking a host. The terminal runs ssh -tt inside the app, so the ssh_config alias, ProxyJump, IdentityFile and your agent all apply." />
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="PuTTY keys are converted to a temporary OpenSSH key, used with " />
            <Run Text="-i" FontFamily="SF Mono, Menlo, monospace" Foreground="{DynamicResource AccentBrush}" />
            <Run Text=", and deleted when the session stops." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="The window closes itself shortly after ssh exits. Closing it manually disconnects." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="Full-screen programs such as k9s, vim and htop are supported by the bundled VT engine." />
          </TextBlock>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="Copying files" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}"
                     Text="Open an SSH session and choose Files… in its header to copy files or folders in either direction. Drop files or folders onto the window, use the local pickers, or use Browse… to open the remote file list." />
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="Upload: drop files or folders onto the window, choose them with the pickers, then use Browse… to pick the remote destination folder." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="Download: use Browse… to select the remote file or folder, then choose the local destination. It defaults to your Downloads folder." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="Folders are recursive. Transfers use rsync with a live progress bar when available, falling back to scp; both use your SSH config, key and agent. They run without a terminal, so password-only hosts need a key or agent." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="{DynamicResource AccentBrush}" />
            <Run Text="If the host asks for a password, a hidden password prompt appears. The password is used only for that transfer and is never stored. After a successful upload the source list is cleared. The transfer log shows progress; Close or Cancel stops an active transfer." />
          </TextBlock>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="Safety and backups" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}">
            <Run Text="Before every write the target is copied to " />
            <Run Text="~/.ssh/.sshdashboard/backups" FontFamily="SF Mono, Menlo, monospace"
                 Foreground="{DynamicResource AccentBrush}" />
            <Run Text=". Writes are atomic and keep the original permissions. Deletions re-read the file and remove only entries that still match, so a concurrent edit is never clobbered." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}"
                     Text="Cmd/Ctrl+Z restores the latest backup. Include files, Match blocks and global Host * blocks are read-only." />
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="Keyboard shortcuts" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <Grid ColumnDefinitions="*,120,120" Margin="16,11">
                <TextBlock Text="ACTION" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaint}" />
                <TextBlock Grid.Column="1" Text="macOS" FontSize="10.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                <TextBlock Grid.Column="2" Text="Windows / Linux" FontSize="10.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderSoft}" />
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Open this help" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="F1" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="F1" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Rescan ~/.ssh" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="F5" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="F5" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Add Host block" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="⌘N" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="Ctrl+N" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Open SSH session" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="⌘⇧T" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="Ctrl+Shift+T" FontFamily="SF Mono, Menlo, monospace" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Select all hosts" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="⌘A" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="Ctrl+A" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Export current view" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="⌘E" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="Ctrl+E" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,120,120" Margin="16,9">
                <TextBlock Text="Restore latest backup" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="⌘Z" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ElevatedBg}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                  <TextBlock Text="Ctrl+Z" FontFamily="SF Mono, Menlo, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="Troubleshooting" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" />
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="#E0AF68" />
            <Run Text="Test connection uses " />
            <Run Text="/usr/bin/nc" FontFamily="SF Mono, Menlo, monospace" Foreground="{DynamicResource AccentBrush}" />
            <Run Text=" on macOS, so private hosts work without a Local Network prompt." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="#E0AF68" />
            <Run Text="If a session fails, the ssh output is shown in the terminal. For more detail run " />
            <Run Text="ssh -v host" FontFamily="SF Mono, Menlo, monospace" Foreground="{DynamicResource AccentBrush}" />
            <Run Text=" in Terminal." />
          </TextBlock>
          <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
            <Run Text="• " Foreground="#E0AF68" />
            <Run Text="Unhandled errors are written to " />
            <Run Text="~/Library/Application Support/SshDashboard/error.log" FontFamily="SF Mono, Menlo, monospace" Foreground="{DynamicResource AccentBrush}" />
            <Run Text="." />
          </TextBlock>
        </StackPanel>

        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" Text="SSH Dashboard" FontSize="11.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMuted}" />
              <TextBlock Text="© 2026 JPHsystems · macOS, Windows and Linux"
                         FontSize="11" Foreground="{DynamicResource TextFaint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Repository" Click="Repo_Click" Classes="ghost" />
              <Button Content="Report an issue" Click="Issues_Click" Classes="ghost" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
