<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SshDashboard.App.Views.SshPasswordWindow"
        Title="SSH password"
        Width="450" Height="255" CanResize="False"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="24,20,24,0">
    <StackPanel Grid.Row="0" Spacing="10">
      <TextBlock Text="Password required" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />
      <TextBlock x:Name="DetailText" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                 Foreground="{DynamicResource TextMuted}" />
      <TextBox x:Name="PasswordBox" Height="34" Watermark="SSH password"
               PasswordChar="●"
               AutomationProperties.Name="SSH password" />
      <TextBlock Text="The password is hidden, used only for this operation and is never saved."
                 FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,14,0,16">
      <Button Content="Cancel" Click="Cancel_Click" Classes="ghost" />
      <Button Content="Continue" Click="Continue_Click" Classes="primary" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
